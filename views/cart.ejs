<%- include('partials/header') %>

<h1 class="font-display text-4xl uppercase tracking-wide">Your cart</h1>

<% if (cart.items.length === 0) { %>
  <div class="card mt-6 px-6 py-16 text-center">
    <p class="text-lg font-semibold">Your cart is empty.</p>
    <a href="/shop" class="btn btn-primary mt-4">Start shopping</a>
  </div>
<% } else { %>
  <div class="mt-6 grid gap-8 lg:grid-cols-3">
    <div class="space-y-3 lg:col-span-2">
      <% cart.items.forEach(function (it) { %>
        <div class="card flex gap-4 p-4">
          <a href="/product/<%= it.product_id %>" class="h-24 w-24 shrink-0 overflow-hidden rounded-lg">
            <%- include('partials/product-image', { p: { id: it.product_id, name: it.name, image_url: it.image_url } }) %>
          </a>
          <div class="flex flex-1 flex-col justify-between">
            <div class="flex justify-between gap-4">
              <div>
                <a href="/product/<%= it.product_id %>" class="font-bold hover:text-volt"><%= it.name %></a>
                <p class="mt-1 flex items-center gap-2 text-sm text-neutral-400">
                  <span class="h-3 w-3 rounded-full border border-white/20" style="background: <%= colorHex(it.color) %>"></span>
                  <%= it.color %> &middot; Size <%= it.size %>
                </p>
              </div>
              <p class="font-bold"><%= money(it.line_total) %></p>
            </div>
            <div class="mt-3 flex items-center justify-between">
              <form action="/cart/update" method="post" class="flex items-center gap-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="variantId" value="<%= it.variant_id %>">
                <input class="input w-20 py-1.5" type="number" name="qty" value="<%= it.qty %>" min="0" max="<%= Math.min(10, it.stock) %>">
                <button type="submit" class="btn btn-outline btn-sm">Update</button>
              </form>
              <form action="/cart/remove" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="variantId" value="<%= it.variant_id %>">
                <button type="submit" class="text-sm text-neutral-400 hover:text-red-400">Remove</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <aside class="card h-fit p-6">
      <h2 class="text-lg font-bold uppercase tracking-wide">Summary</h2>
      <dl class="mt-4 space-y-2 text-sm">
        <div class="flex justify-between"><dt class="text-neutral-400">Items</dt><dd><%= cart.count %></dd></div>
        <div class="flex justify-between"><dt class="text-neutral-400">Shipping</dt><dd>Free</dd></div>
        <div class="flex justify-between border-t border-ink-700 pt-3 text-lg font-bold"><dt>Total</dt><dd class="text-volt"><%= money(cart.total) %></dd></div>
      </dl>
      <a href="/cart/checkout" class="btn btn-primary mt-6 w-full">Checkout</a>
      <a href="/shop" class="mt-3 block text-center text-sm text-neutral-400 hover:text-white">Continue shopping</a>
    </aside>
  </div>
<% } %>

<%- include('partials/footer') %>
