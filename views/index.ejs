<%- include('partials/header') %>

<section class="relative overflow-hidden rounded-2xl border border-ink-700 bg-gradient-to-br from-ink-800 via-ink-900 to-ink-950 px-6 py-16 sm:px-12 sm:py-24">
  <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-volt/20 blur-3xl"></div>
  <p class="text-sm font-bold uppercase tracking-[0.3em] text-volt">New season drop</p>
  <h1 class="mt-4 max-w-3xl font-display text-5xl uppercase leading-none tracking-wide sm:text-7xl">
    Fresh kicks. <span class="text-volt">Heavy fits.</span>
  </h1>
  <p class="mt-6 max-w-xl text-neutral-300">Sneakers, hoodies, tees and more in limited runs. Pick your size and color, and track every order from pending to delivered.</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/shop" class="btn btn-primary">Shop all</a>
    <a href="/shop?category=sneakers" class="btn btn-outline">Browse sneakers</a>
  </div>
</section>

<section class="mt-12">
  <h2 class="font-display text-3xl uppercase tracking-wide">Shop by category</h2>
  <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    <% categories.forEach(function (c) { %>
      <a href="/shop?category=<%= c.slug %>" class="card px-4 py-6 text-center font-bold uppercase tracking-wide hover:border-volt hover:text-volt"><%= c.name %></a>
    <% }) %>
  </div>
</section>

<section class="mt-12">
  <div class="flex items-end justify-between">
    <h2 class="font-display text-3xl uppercase tracking-wide">Latest drops</h2>
    <a href="/shop" class="text-sm font-semibold text-volt hover:underline">View all</a>
  </div>
  <div class="mt-5 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <% featured.forEach(function (p) { %>
      <%- include('partials/product-card', { p: p }) %>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
