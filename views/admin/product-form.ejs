<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<a href="/admin/products" class="text-sm text-neutral-400 hover:text-white">&larr; All products</a>
<h1 class="mt-2 font-display text-4xl uppercase tracking-wide"><%= product ? 'Edit product' : 'New product' %></h1>

<% if (errors.length) { %>
  <div class="mt-4 rounded-md border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-300">
    <ul class="list-inside list-disc">
      <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" method="post" enctype="multipart/form-data" class="card mt-6 grid gap-5 p-6 md:grid-cols-2">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div>
    <label class="label" for="name">Name</label>
    <input class="input" id="name" name="name" value="<%= values.name || '' %>" required>
  </div>
  <div>
    <label class="label" for="brand">Brand</label>
    <input class="input" id="brand" name="brand" value="<%= values.brand || '' %>">
  </div>
  <div>
    <label class="label" for="category_id">Category</label>
    <select class="input" id="category_id" name="category_id" required>
      <option value="">Choose a category</option>
      <% categories.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= Number(values.category_id) === c.id ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label class="label" for="price">Price (USD)</label>
    <input class="input" id="price" name="price" inputmode="decimal" placeholder="89.00" value="<%= values.price || '' %>" required>
  </div>
  <div class="md:col-span-2">
    <label class="label" for="description">Description</label>
    <textarea class="input" id="description" name="description" rows="4"><%= values.description || '' %></textarea>
  </div>
  <div>
    <label class="label" for="image">Product image (JPG, PNG or WebP, max 2 MB)</label>
    <input class="input" id="image" type="file" name="image" accept="image/jpeg,image/png,image/webp">
    <% if (product && product.image_url) { %>
      <div class="mt-3 flex items-center gap-3">
        <img src="<%= product.image_url %>" alt="" class="h-16 w-16 rounded-md object-cover">
        <label class="flex items-center gap-2 text-sm text-neutral-300"><input type="checkbox" name="remove_image" value="1"> Remove image</label>
      </div>
    <% } %>
  </div>
  <div class="flex items-end">
    <label class="flex items-center gap-2 text-sm font-semibold">
      <input type="checkbox" name="is_active" value="1" <%= values.is_active ? 'checked' : '' %>>
      Visible in the store
    </label>
  </div>
  <div class="md:col-span-2">
    <button type="submit" class="btn btn-primary"><%= product ? 'Save changes' : 'Create product' %></button>
  </div>
</form>

<% if (product) { %>
  <section class="card mt-8 overflow-hidden">
    <div class="border-b border-ink-700 px-5 py-4">
      <h2 class="font-bold uppercase tracking-wide">Sizes, colors and stock</h2>
    </div>

    <table class="w-full">
      <thead class="border-b border-ink-700">
        <tr><th class="th">Size</th><th class="th">Color</th><th class="th">Stock</th><th class="th"></th></tr>
      </thead>
      <tbody class="divide-y divide-ink-700">
        <% if (variants.length === 0) { %>
          <tr><td colspan="4" class="td py-8 text-center text-neutral-400">No variants yet. Add the first size and color below.</td></tr>
        <% } %>
        <% variants.forEach(function (v) { %>
          <tr>
            <td class="td font-semibold"><%= v.size %></td>
            <td class="td">
              <span class="inline-flex items-center gap-2">
                <span class="h-3.5 w-3.5 rounded-full border border-white/20" style="background: <%= colorHex(v.color) %>"></span><%= v.color %>
              </span>
            </td>
            <td class="td">
              <form action="/admin/variants/<%= v.id %>" method="post" class="flex items-center gap-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input class="input w-24 py-1.5" type="number" name="stock" value="<%= v.stock %>" min="0">
                <button type="submit" class="btn btn-outline btn-sm">Save</button>
              </form>
            </td>
            <td class="td text-right">
              <form action="/admin/variants/<%= v.id %>/delete" method="post" onsubmit="return confirm('Remove this variant?');" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <form action="/admin/products/<%= product.id %>/variants" method="post" class="grid items-end gap-3 border-t border-ink-700 bg-ink-800/50 p-5 sm:grid-cols-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label class="label" for="v-size">Size</label><input class="input" id="v-size" name="size" placeholder="M, 9, One Size" required></div>
      <div><label class="label" for="v-color">Color</label><input class="input" id="v-color" name="color" placeholder="Black" required></div>
      <div><label class="label" for="v-stock">Stock</label><input class="input" id="v-stock" type="number" name="stock" min="0" value="0" required></div>
      <button type="submit" class="btn btn-primary">Add variant</button>
    </form>
  </section>
<% } %>

<%- include('../partials/footer') %>
