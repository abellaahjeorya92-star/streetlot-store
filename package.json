{
  "name": "streetlot-store",
  "version": "1.0.0",
  "description": "STREETLOT - a streetwear and sneaker e-commerce web app (Express, EJS, Tailwind CSS, SQLite)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "seed:reset": "node scripts/reset-db.js",
    "postinstall": "npm run build:css"
  },
  "engines": {
    "node": ">=18.11"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.10"
  }
}
